// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in real values.
// Then run `xcodegen generate` and open the .xcodeproj.
//
// GOOGLE_CLIENT_ID: the "iOS" OAuth client ID from Google Cloud Console →
//   APIs & Services → Credentials. Looks like
//   123456789012-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

// GOOGLE_REVERSED_CLIENT_ID: the same ID with its dot-segments reversed. Google
//   shows this on the client's detail page as "iOS URL scheme". Looks like
//   com.googleusercontent.apps.123456789012-abcdefghijklmnop
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID

// DEVELOPMENT_TEAM: your Apple signing team ID (10 characters). Find it in
//   Xcode → Settings → Accounts → your Apple ID → team, or leave blank and pick
//   the team in the Signing & Capabilities tab after generating the project.
DEVELOPMENT_TEAM =
